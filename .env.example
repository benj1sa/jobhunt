# Development environment
# IS_DEV=true
# DEBUG=false

# Database connection (SQLite file in the project root by default)
# DATABASE_URL=sqlite:///./jobhunt.db

# Who runs extraction and the LLM fit: openrouter (API key, pay per token) or chatgpt (your ChatGPT plan).
# For chatgpt, run `jobhunt chatgpt login` once on this machine. Keep GitHub Actions on openrouter.
# LLM_PROVIDER=openrouter
# CHATGPT_MODEL=gpt-5.6-luna
# CHATGPT_FIT_MODEL=gpt-5.6-luna
# CHATGPT_REASONING_EFFORT=low

# OpenRouter: needed for extraction and the fit judgment when LLM_PROVIDER=openrouter.
# OPENROUTER_API_KEY=sk-or-...
# EXTRACTION_MODEL=anthropic/claude-haiku-5.5
# FIT_MODEL=anthropic/claude-sonnet-5.5

# TypeSafe Jev: optional. Screens descriptions before extraction and judges fit (FIT_PROVIDER=auto picks it).
# TYPESAFE_API_KEY=...
# Pin a version (e.g. jev-1.14.0) once questions are tuned, so answers don't shift between releases:
# JEV_MODEL=jev-latest
# Who judges fit: auto | jev | llm | none   (llm = the LLM_PROVIDER model; free on the ChatGPT plan)
# FIT_PROVIDER=auto

# Config files (paths relative to where you run jobhunt)
# PROFILE_PATH=config/profile.toml
# BOARDS_PATH=config/boards.toml
# SKILLS_ALIASES_PATH=config/skills.toml

# Discovery tuning
# SIMPLIFY_MAX_AGE_DAYS=45
# HN_MONTHS_BACK=1
# HTTP_CONCURRENCY=8
