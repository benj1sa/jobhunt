# Development environment
# IS_DEV=true
# DEBUG=false

# Database connection (SQLite file in the project root by default)
# DATABASE_URL=sqlite:///./jobhunt.db

# OpenRouter: required for extraction and the fit judgment. Without it the pipeline stops after hydration.
# OPENROUTER_API_KEY=sk-or-...
# EXTRACTION_MODEL=anthropic/claude-haiku-5.5
# FIT_MODEL=anthropic/claude-sonnet-5.5

# TypeSafe Jev: optional. Screens descriptions before extraction and judges fit (FIT_PROVIDER=auto picks it).
# TYPESAFE_API_KEY=...
# JEV_MODEL=jev-latest          # pin e.g. jev-1.14.0 for stable answers
# FIT_PROVIDER=auto             # auto | jev | openrouter | none

# Config files (paths relative to where you run jobhunt)
# PROFILE_PATH=config/profile.toml
# BOARDS_PATH=config/boards.toml
# SKILLS_ALIASES_PATH=config/skills.toml

# Discovery tuning
# SIMPLIFY_MAX_AGE_DAYS=45
# HN_MONTHS_BACK=1
# HTTP_CONCURRENCY=8
